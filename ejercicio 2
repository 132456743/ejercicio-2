import java.util.Scanner;

public class Ejercicio2 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        final double MINIMO_APROBATORIO = 70.0;
        final double MINIMO_UNIDAD = 60.0;

        System.out.print("Ingrese la calificación de la Unidad 1: ");
        double cal1 = scanner.nextDouble();
        System.out.print("Ingrese la calificación de la Unidad 2: ");
        double cal2 = scanner.nextDouble();
        System.out.print("Ingrese la calificación de la Unidad 3: ");
        double cal3 = scanner.nextDouble();

        double promedio = (cal1 + cal2 + cal3) / 3.0;

        System.out.println("\n--- RESULTADOS ---");
        System.out.println("Calificación 1: " + cal1);
        System.out.println("Calificación 2: " + cal2);
        System.out.println("Calificación 3: " + cal3);
        System.out.println("Promedio: " + promedio);

        if (promedio >= MINIMO_APROBATORIO) {
            System.out.println("Estatus: APROBADO");
        } else {
            System.out.println("Estatus: REPROBADO");
        }

        if (cal1 < MINIMO_UNIDAD) {
            System.out.println("Debe presentar recuperación en la Unidad 1.");
        }
        if (cal2 < MINIMO_UNIDAD) {
            System.out.println("Debe presentar recuperación en la Unidad 2.");
        }
        if (cal3 < MINIMO_UNIDAD) {
            System.out.println("Debe presentar recuperación en la Unidad 3.");
        }
    }
}
